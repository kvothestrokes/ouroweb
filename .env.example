# ── Supabase ──────────────────────────────────────────
# Project Settings → API. En proyectos antiguos: anon key y service_role key.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Solo para el MCP de Supabase en Claude Code
SUPABASE_PROJECT_REF=

# ── ImageKit ──────────────────────────────────────────
# Developer options → API keys
PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit-id>
PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Carpeta raíz en ImageKit
PUBLIC_IMAGEKIT_ROOT=ouroboros
