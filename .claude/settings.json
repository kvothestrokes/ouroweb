{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run:*)",
			"Bash(npm install:*)",
			"Bash(npm i:*)",
			"Bash(npm ls:*)",
			"Bash(npx sv:*)",
			"Bash(npx shadcn-svelte@latest:*)",
			"Bash(npx prettier:*)",
			"Bash(npx eslint:*)",
			"Bash(npx vitest:*)",
			"Bash(npx svelte-check:*)",
			"Bash(npx supabase migration new:*)",
			"Bash(npx supabase gen types:*)",
			"Bash(npx supabase status:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git checkout -b:*)",
			"Bash(git switch:*)",
			"Bash(git branch:*)",
			"Bash(ls:*)",
			"Bash(mkdir:*)",
			"Bash(cat:*)",
			"Bash(grep:*)",
			"Bash(find:*)"
		],
		"ask": [
			"Bash(git push:*)",
			"Bash(npx supabase db push:*)",
			"Bash(npx supabase db reset:*)",
			"Bash(npx supabase link:*)",
			"Bash(npx vercel:*)",
			"Bash(vercel:*)",
			"Bash(rm:*)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.production)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(rm -rf:*)"
		]
	},
	"enabledMcpjsonServers": ["svelte", "supabase"]
}
